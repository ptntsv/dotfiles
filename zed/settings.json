// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5-mini",
      "enable_thinking": false
    },
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "openai",
      "model": "gpt-4",
      "enable_thinking": false
    },
    "model_parameters": []
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "buffer_font_weight": 450.0,
  "ssh_connections": [
    {
      "host": "192.168.1.61",
      "username": "aptntsv",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/aptntsv"
          ]
        }
      ]
    }
  ],
  "tab_size": 2,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "lsp": {
    "hls": {
      "initialization_options": {
        "haskell": {
          "plugin": {
            "rename": {
              "config": {
                "crossModule": true,
              },
            },
          },
        },
      },
    },
  },
}
